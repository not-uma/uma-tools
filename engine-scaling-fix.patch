+	// LOCAL PATCH. Mirrors the modifier-scaling table the upstream engine uses.
+	// A dedicated per-skill RNG keeps the two solvers in a comparison in sync:
+	// drawing from the shared rng here would desync them, because the two umas
+	// activate different numbers of skills.
+	getScalingRng(_skillId: string) {
+		return this.modifierScalingRng;
+	}
+
+	getScaledModifier(skillId: string, ef) {
+		const a = ef.modifier;
+		switch (ef.modifierScaling) {
+		case 1: return a;
+		case 2: case 3: case 4: case 5: case 6: case 7: return a * 1.2;
+		case 8: case 9: {
+			const i = this.getScalingRng(skillId).uniform(10);
+			return a * (i < 6 ? 0 : i < 9 ? 0.02 : 0.04);
+		}
+		case 10: return a * 1.2;
+		case 11: return a;
+		case 12: return a * 1.2;
+		case 13: return a;
+		case 14: {
+			// upstream keys this off a tag-group activation count we do not track;
+			// fall back to the base value rather than guessing.
+			return a;
+		}
+		case 19: return a + 0.1 * this.getScalingRng(skillId).uniform(2);
+		case 20: case 21: case 22: case 23: case 24: return a;
+		case 25: return a * [1, 1.4, 1.8][this.getScalingRng(skillId).uniform(3)];
+		case 26: case 28: case 32: return a * 1.2;
+		case 34: return a;
+		default: return a;
+		}
+	}
+
 	activateSkill(s: PendingSkill) {
 		// sort so that the ExtendEvolvedDuration effect always activates after other effects, since it shouldn't extend the duration of other
 		// effects on the same skill
-		s.effects.sort((a,b) => +(a.type == 42) - +(b.type == 42)).forEach(ef => {
+		s.effects.sort((a,b) => +(a.type == 42) - +(b.type == 42)).forEach(ef_ => {
+			// LOCAL PATCH: several effects list a BASE modifier that has to be scaled
+			// before use. Most notably scaling 8 (Risky Business / Nothing Ventured),
+			// whose listed -100% stamina is really a base of 1 multiplied by a random
+			// 0 / 0.02 / 0.04. Without this the drain empties the whole HP bar.
+			const ef = ef_.modifierScaling == null || ef_.modifierScaling == 1 ? ef_
+				: Object.assign({}, ef_, {modifier: this.getScaledModifier(s.skillId, ef_)});
 			const scaledDuration = ef.baseDuration * (this.course.distance / 1000) *
 				(s.rarity == SkillRarity.Evolution ? this.modifiers.specialSkillDurationScaling : 1);  // TODO should probably be awakened skills
 				                                                                                       // and not just pinks
